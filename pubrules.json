{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "npm ci --ignore-scripts",
      "test": "npm test",
      "coverage-report": "coverage/lcov.info",
      "shellcheck": "with-secrets scripts/*.sh"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "secrets": [
    {
      "from": "sustenaut-deploy-ssh-key",
      "to": "SUSTENAUT_DEPLOY_SSH_KEY",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_CLIENT_ID",
      "to": "TS_GH_OAUTH_CLIENT_ID",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_SECRET",
      "to": "TS_GH_OAUTH_SECRET",
      "kind": "secret"
    },
    {
      "from": "sustenaut-server",
      "to": "SUSTENAUT_SERVER",
      "kind": "variable"
    },
    {
      "from": "sustenaut-known-hosts",
      "to": "SUSTENAUT_KNOWN_HOSTS",
      "kind": "variable"
    }
  ],
  "deploy": {
    "providers": [
      {
        "distribution": "pubdeploy",
        "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.5.0/pubdeploy-0.5.0-py3-none-any.whl",
        "sha256": "320d68e081c674457294e6ed3a6c8ab9e2606ca4a2946c252a34021b62dc70cd"
      },
      {
        "distribution": "pubsec",
        "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.3.0/pubsec-0.3.0-py3-none-any.whl",
        "sha256": "a9036c741e29098cdd04baf64c7873e0ff1dd6e7bde12e9671a3940370724e18"
      }
    ],
    "namespace": "dashboard",
    "host": "dashboard.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_DASHBOARD",
    "needs": [
      {
        "type": "bitwarden.secret",
        "name": "dashboard-app-id",
        "secret": {
          "name": "dashboard-secrets",
          "key": "app-id"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "dashboard-app-key",
        "secret": {
          "name": "dashboard-secrets",
          "key": "app-key"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "dashboard-client-id",
        "secret": {
          "name": "dashboard-secrets",
          "key": "client-id"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "dashboard-client-secret",
        "secret": {
          "name": "dashboard-secrets",
          "key": "client-secret"
        }
      },
      {
        "type": "bitwarden.generated",
        "name": "dashboard-session-secret",
        "shape": "base64-32",
        "secret": {
          "name": "dashboard-secrets",
          "key": "session-secret"
        }
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
